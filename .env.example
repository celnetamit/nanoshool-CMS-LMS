# Environment Variables — NSTC Platform

# ─── App ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nstc_db

# ─── Payload CMS ────────────────────────────────
PAYLOAD_SECRET=change_this_to_a_random_32_char_string

# ─── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (NextAuth) ────────────────────────────
NEXTAUTH_SECRET=change_this_to_a_random_32_char_string
NEXTAUTH_URL=http://localhost:3000

# ─── Razorpay ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── Moodle ─────────────────────────────────────
MOODLE_BASE_URL=https://lms.yourdomain.com
MOODLE_API_TOKEN=your_moodle_webservice_token

# ─── Storage (S3 / Cloudflare R2) ───────────────
S3_REGION=ap-south-1
S3_BUCKET=nstc-media
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_ENDPOINT=https://your-r2-endpoint.r2.cloudflarestorage.com

# ─── Search (Meilisearch) ───────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key

# ─── Analytics (PostHog) ────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Email ──────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# ─── Admin ──────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
